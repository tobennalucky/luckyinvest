# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed.

# Finnhub API key (server-side only — do not prefix with NEXT_PUBLIC_)
# Get one at https://finnhub.io/dashboard
FINNHUB_API_KEY=

# Alpha Vantage API key (server-side only — used for historical stock charts)
# Get one at https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# Supabase project (client-safe values — see https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
